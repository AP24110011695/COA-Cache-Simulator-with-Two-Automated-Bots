{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "state.schema.json",
  "title": "Cache state",
  "description": "Final (and optional per-access) cache state (architecture.md 6.7). last_used_rank (1 = most recent) applies to LRU; FIFO reports insert_order_rank instead; both null for RANDOM. No write/dirty state exists anywhere (read-only scope).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sets"],
  "properties": {
    "sets": { "$ref": "#/definitions/sets_array" },
    "snapshots": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "sets"],
            "properties": {
              "n": { "type": "integer", "minimum": 1 },
              "sets": { "$ref": "#/definitions/sets_array" }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["way", "valid", "tag", "block", "last_used_rank"],
      "properties": {
        "way": { "type": "integer", "minimum": 0 },
        "valid": { "type": "boolean" },
        "tag": { "type": ["integer", "null"] },
        "block": { "type": ["integer", "null"] },
        "last_used_rank": { "type": ["integer", "null"] },
        "insert_order_rank": { "type": ["integer", "null"] }
      }
    },
    "sets_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/definitions/line" }
      }
    }
  }
}
